# Only PUBLIC values go here. Anything starting with VITE_ is visible to every visitor.
# Same Client ID as GOOGLE_CLIENT_ID in server/.env. Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=
# Optional: a looping background video for the home page. Or just drop a file at client/public/hero.mp4
VITE_HERO_VIDEO_URL=
